{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/cron/heartbeat",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/healthz",
      "destination": "/api/healthz"
    },
    {
      "source": "/status/:target",
      "destination": "/status.html?target=:target"
    },
    {
      "source": "/preview",
      "destination": "/api/preview"
    },
    {
      "source": "/preview/:template",
      "destination": "/api/preview?template=:template"
    }
  ],
  "regions": [
    "icn1"
  ]
}
